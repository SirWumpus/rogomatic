          [ [1m-a [4m[22msecs[24m ] [ [1m-d [22m] [ [1m-D [4m[22mrgmdir[24m ] [ [1m-e [22m] [ [1m-f [4m[22mrogue[24m ] [ [1m-G [4m[22mgoodlvl[24m ]  [
          [1m-H [22m]
          [ [1m-P [4m[22mplayer[24m ] [ [1m-r [4m[22mrogomatic[24m ] [ [1m-S [4m[22mROGOSEED[24m ] [ [1m-U [4m[22musec[24m ] [ [1m-Z [22m]

     [4mrerun_rogo[0m
          [ [1m-h [22m] [ [1m-V [22m] [ [1m-v [4m[22mlevel[24m ] [ [1m-n [22m] [ [1m-N [22m]
          [ [1m-i [4m[22midlesec[24m ] [ [1m-R [4m[22mrun_rogo[24m ] [ [1m-s [4m[22mstopfile[24m ]
          [  [1m-a [4m[22msecs[24m ] [ [1m-d [22m] [ [1m-D [4m[22mrgmdir[24m ] [ [1m-e [22m] [ [1m-f [4m[22mrogue[24m ] [ [1m-G [4m[22mgoodlvl[24m ] [
          [1m-H [22m]
          [ [1m-P [4m[22mplayer[24m ] [ [1m-r [4m[22mrogomatic[24m ] [ [1m-S [4m[22mROGOSEED[24m ] [ [1m-U [4m[22musec[24m ] [ [1m-Z [22m]

     [4mend_player[0m
          [ [1m-h [22m] [ [1m-V [22m] [ [1m-v [4m[22mlevel[24m ] [ [1m-n [22m] [ [1m-N [22m]
          [ [1m-u [4m[22muser[24m ]

     [4mmrerun_rogo[0m
          [ [1m-h [22m] [ [1m-V [22m] [ [1m-v [4m[22mlevel[24m ] [ [1m-n [22m] [ [1m-N [22m]
          [ [1m-i [4m[22midlesec[24m ] [ [1m-o [4m[22munstuck_player[24m ] [ [1m-O [4m[22mrerun_rogo[24m ] [ [1m-R [4m[22mrun_rogo[24m ]
          [ [1m-s [4m[22mstopfile[24m ]
          [ [1m-a [4m[22msecs[24m ] [ [1m-d [22m] [ [1m-D [4m[22mbase_rgmdir[24m ] [ [1m-e [22m] [ [1m-f [4m[22mrogue[24m ] [ [1m-G [4m[22mgoodlvl[0m
          ] [ [1m-H [22m]
          [ [1m-P [4m[22mplayer[24m ] [ [1m-r [4m[22mrogomatic[24m ] [ [1m-S [4m[22mROGOSEED[24m ] [ [1m-U [4m[22musec[24m ] [ [1m-Z [22m]

