[4mROGOMATIC[24m(6)                      Games Manual                      [4mROGOMATIC[24m(6)

[1mNAME[0m
     rogomatic,  run_rogo, rerun_rogo, mrerun_rogo, end_player, unstuck_player -
     Automatically Exploring The Dungeons of Doom

[1mSYNOPSIS[0m
     [4mrogomatic[0m
          [ [1m-h [22m] [ [1m-V [22m]
          [ [1m-a [4m[22msecs[24m ] [ [1m-c [22m] [ [1m-d [22m] [ [1m-D [4m[22mrgmdir[24m ] [ [1m-e [22m] [ [1m-E [22m] [ [1m-f [4m[22mrogue[24m  ]  [
          [1m-G [4m[22mgoodlvl[24m ]
          [  [1m-H [22m] [ [1m-p [22m] [ [1m-P [4m[22mplayer[24m ] [ [1m-q [22m] [ [1m-r [22m] [ [1m-S [4m[22mROGOSEED[24m ] [ [1m-t [22m] [ [1m-u[0m
          ] [ [1m-U [4m[22musec[24m ] [ [1m-w [22m]
